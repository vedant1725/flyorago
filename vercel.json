{
  "buildCommand": "cd flyora-frontend && npm run build",
  "installCommand": "cd flyora-frontend && npm install",
  "outputDirectory": "flyora-frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.flyorago.me/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://api.flyorago.me/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
